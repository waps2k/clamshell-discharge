#!/bin/bash
# clamshell-discharge — 어댑터를 꽂은 채(클램쉘 포함) 배터리를 목표 %까지 능동 방전
#
# 동작:
#   1) pmset disablesleep 1  → 덮개를 닫아도 잠들지 않게 함 (방전 중 macOS는 '배터리 전원'으로 인식하므로
#      caffeinate -s 만으로는 클램쉘 잠자기를 막지 못함)
#   2) caffeinate -dimu      → 유휴/디스크/디스플레이 잠자기 방지
#   3) battery discharge N   → actuallymentor/battery CLI 로 SMC 어댑터 차단 후 목표까지 방전
#   4) 퇴근 감지: 덮개 닫힌 채 외장 모니터 또는 어댑터를 뽑으면 즉시 중단 후 잠자기
#   종료/중단(Ctrl+C, SIGTERM, 오류) 시 항상: 방전 해제 + disablesleep 원래 값 복원
#
# 사용법:  clamshell-discharge 80        (80%까지 방전)
#          clamshell-discharge --restore (비상 복구: 방전 해제 + 잠자기 복원)
#
# 필요: battery CLI (https://github.com/actuallymentor/battery)
#       /etc/sudoers.d/clamshell-discharge (pmset -a disablesleep 0/1 을 비밀번호 없이 허용)

set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin

SMC_BIN=/usr/local/co.palokaj.battery/smc
PMSET=/usr/bin/pmset
MIN_TARGET=20
STATE_FILE="$HOME/.battery/clamshell-discharge.sleepdisabled"
# 실행 중 목표 변경: 이 파일의 숫자를 바꾸면 다음 확인(10초 이내)부터 새 목표 적용
TARGET_FILE="$HOME/.battery/clamshell-discharge.target"

log() { echo "[$(date '+%H:%M:%S')] $*"; }

pct() { pmset -g batt | grep -Eo '[0-9]+%' | head -1 | tr -d '%'; }

lid_closed() { ioreg -r -k AppleClamshellState -d 4 | grep -q '"AppleClamshellState" = Yes'; }

# 어댑터가 물리적으로 꽂혀 있는지: USB-C PD 전원 계약 기준 와트 (방전 중에도 유지, 뽑으면 0)
# PD 정보가 없는 기종이면 AdapterDetails 로 대신함 (뽑은 뒤에도 값이 남을 수 있음)
adapter_watts() {
	local out
	out=$(ioreg -r -k PortControllerInfo -d 1 2>/dev/null)
	if [[ "$out" == *PortControllerMaxPower* ]]; then
		echo "$out" | tr '{' '\n' | awk '/PortControllerMaxPower/ {
			rdo = 0; mp = 0
			if (match($0, /"PortControllerActiveContractRdo"=[0-9]+/)) { split(substr($0, RSTART, RLENGTH), a, "="); rdo = a[2] }
			if (match($0, /"PortControllerMaxPower"=[0-9]+/)) { split(substr($0, RSTART, RLENGTH), b, "="); mp = b[2] }
			if (rdo + 0 > 0 && mp + 0 > w) w = mp + 0
		} END { print int(w / 1000) }'
	else
		ioreg -rn AppleSmartBattery | grep -o '"AdapterDetails" = {[^}]*}' | grep -Eo '"Watts"=[0-9]+' | head -1 | cut -d= -f2
	fi
}

ext_displays() { system_profiler SPDisplaysDataType 2>/dev/null | grep -c "Resolution:"; }

# 퇴근 감지: 덮개 닫힘 + (외장 모니터 없음 또는 어댑터 뽑힘) 이면 이유를 출력하고 0 반환
leaving() {
	lid_closed || return 1
	local w; w=$(adapter_watts)
	if [[ -z "$w" || "$w" == "0" ]]; then echo "어댑터 분리"; return 0; fi
	if (( $(ext_displays) == 0 )); then echo "외장 모니터 분리"; return 0; fi
	return 1
}

set_sleep_disabled() { sudo -n "$PMSET" -a disablesleep "$1" 2>/dev/null; }

# 이 기기가 지원하는 어댑터 차단 키로 방전 시작 (battery CLI sudoers 가 비밀번호 없이 허용)
start_discharge() {
	if "$SMC_BIN" -k CHIE -r 2>/dev/null | grep -q 'bytes'; then
		sudo -n "$SMC_BIN" -k CHIE -w 08 >/dev/null 2>&1
	elif "$SMC_BIN" -k CH0J -r 2>/dev/null | grep -q 'bytes'; then
		sudo -n "$SMC_BIN" -k CH0J -w 01 >/dev/null 2>&1
	else
		sudo -n "$SMC_BIN" -k CH0I -w 01 >/dev/null 2>&1
	fi
}

discharging_now() { pmset -g batt | head -1 | grep -q "Battery Power"; }

read_target() {
	local t
	t=$(cat "$TARGET_FILE" 2>/dev/null | tr -dc '0-9')
	if [[ "$t" =~ ^[0-9]+$ ]] && (( t >= MIN_TARGET && t <= 100 )); then echo "$t"; else echo "$target"; fi
}

stop_discharge() {
	# battery visudo 규칙에서 비밀번호 없이 허용된 명령들. 지원하지 않는 키는 조용히 무시.
	sudo -n "$SMC_BIN" -k CHIE -w 00 >/dev/null 2>&1
	sudo -n "$SMC_BIN" -k CH0J -w 00 >/dev/null 2>&1
	sudo -n "$SMC_BIN" -k CH0I -w 00 >/dev/null 2>&1
}

restore_sleep() {
	local orig=0
	[[ -f "$STATE_FILE" ]] && orig=$(cat "$STATE_FILE")
	[[ "$orig" =~ ^[01]$ ]] || orig=0
	if set_sleep_disabled "$orig"; then
		rm -f "$STATE_FILE"
		log "잠자기 설정 복원 (disablesleep=$orig)"
	else
		log "⚠️  잠자기 복원 실패! 직접 실행하세요: sudo pmset -a disablesleep $orig"
	fi
}

if [[ "${1:-}" == "--restore" ]]; then
	stop_discharge
	restore_sleep
	log "복구 완료. 현재: $(pmset -g batt | tail -1)"
	exit 0
fi

target="${1:-}"
if ! [[ "$target" =~ ^[0-9]+$ ]] || (( target < MIN_TARGET || target > 100 )); then
	echo "사용법: $(basename "$0") <목표%: $MIN_TARGET-100>   |   $(basename "$0") --restore"
	exit 1
fi

if [[ ! -x "$SMC_BIN" ]]; then
	log "❌ battery CLI 가 없습니다 (https://github.com/actuallymentor/battery)"
	exit 1
fi

if [[ ! -e /etc/sudoers.d/clamshell-discharge ]]; then
	log "❌ 권한 설정이 필요합니다 (/etc/sudoers.d/clamshell-discharge). 메뉴 막대 앱의 '권한 설정'을 먼저 실행하세요."
	exit 1
fi

if launchctl print system/com.apphousekitchen.aldente-pro.helper >/dev/null 2>&1; then
	log "❌ AlDente helper 가 아직 실행 중입니다. 충돌할 수 있으니 먼저 제거하세요."
	exit 1
fi

now=$(pct)
if (( now <= target )); then
	log "이미 ${now}% (목표 ${target}% 이하) — 할 일 없음"
	exit 0
fi

w=$(adapter_watts)
[[ -n "$w" && "$w" != "0" ]] || pmset -g batt | grep -q "AC Power" || log "⚠️  지금 어댑터가 연결돼 있지 않습니다 (그냥 배터리로 소모됩니다)."

# 원래 disablesleep 값 기록 (비정상 종료돼도 --restore 로 되돌릴 수 있게 파일에 저장)
mkdir -p "$(dirname "$STATE_FILE")"
if [[ ! -f "$STATE_FILE" ]]; then
	pmset -g | awk '/SleepDisabled/ {print $2}' > "$STATE_FILE"
fi

echo "$target" > "$TARGET_FILE"
CAF_PID=""; SLEEP_AFTER=0
cleanup() {
	trap - EXIT INT TERM HUP
	log "정리 중…"
	[[ -n "$CAF_PID" ]] && kill "$CAF_PID" 2>/dev/null
	stop_discharge
	restore_sleep
	rm -f "$TARGET_FILE"
	log "종료. 현재: $(pmset -g batt | tail -1 | sed 's/^[[:space:]]*//')"
	if (( SLEEP_AFTER )); then
		log "덮개가 닫혀 있으므로 지금 잠자기"
		pmset sleepnow >/dev/null
	fi
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

if set_sleep_disabled 1; then
	log "클램쉘 잠자기 차단 (disablesleep=1)"
else
	log "❌ 잠자기 차단 실패 (권한 설정을 다시 하세요) — 방전하지 않고 종료"
	exit 1
fi

caffeinate -dimu &
CAF_PID=$!

log "방전 시작: ${now}% → ${target}%"
start_discharge

# 목표 도달까지: 목표 파일 재확인(실시간 변경) + 퇴근 감지 + 차단 유지 확인
n=0
while true; do
	new=$(read_target)
	if [[ "$new" != "$target" ]]; then
		log "🎯 목표 변경: ${target}% → ${new}%"
		target=$new
	fi
	p=$(pct)
	if (( p <= target )); then
		log "목표 도달: ${p}% (목표 ${target}%)"
		break
	fi
	if why=$(leaving); then
		log "🚶 퇴근 감지 ($why) — 방전 중단"
		SLEEP_AFTER=1
		exit 0
	fi
	# 다른 프로그램이 차단을 풀었으면 다시 차단
	discharging_now || start_discharge
	(( n++ % 6 )) || log "배터리 ${p}% → 목표 ${target}%  ($(pmset -g batt | head -1 | sed "s/Now drawing from //"))"
	sleep 10
done
log "방전 완료"
